@prefix batext: <https://w3id.org/eudpp/battery-extinguisher-classes#> .
@prefix batlab: <https://w3id.org/eudpp/battery-labeling#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# The five extinguisher classes A, B, C, D and K, replacing the free
# text of batlab:extinguishingAgent. skos:notation carries the letter.
#
# OPEN POINT — the reference standard is not settled. The five letters
# are those of the Spherity Battery Pass ontology v0.1
# ("classes of extinguishers (A, B, C, D, K)"). BatteryPass-Ready
# Data Attribute Long List v1.3, attribute 24, instead points to
# EN 2:2005, which defines A, B, C, D and F — class K belongs to
# NFPA 10 (US) and its EN 2 counterpart is class F. Class C also
# differs between the two schemes (gases in EN 2, electrical equipment
# in NFPA 10). Per-concept definitions are therefore deliberately
# scheme-neutral: see the scopeNote of the scheme.

<https://w3id.org/eudpp/battery-extinguisher-classes>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-extinguisher-classes/0.1.1> ;
    rdfs:seeAlso <https://w3id.org/eudpp/battery-labeling> ;
    rdfs:label "EU DPP Battery Extinguisher Classes Vocabulary"@en ;
    dcterms:title "EU DPP Battery Extinguisher Classes Vocabulary"@en ;
    dcterms:description "Controlled vocabulary of the extinguisher classes applicable to a battery, used as the value set of batlab:extinguishingAgent. Replaces the free-text values of the battery-labeling module. The five terms are taken from the Spherity Battery Pass ontology v0.1; the reference standard behind them is an open point recorded in the scheme scopeNote."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology v2.0 (update of 30 April 2026). External references are pinned to these versions."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:bibliographicCitation "EU DPP Battery Extinguisher Classes Vocabulary. Draft version 0.1.1."@en ;
    dcterms:creator "Nader Jelassi"@en , "Marc-Andree Wolf"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-08-19"^^xsd:date ;
    dcterms:issued "2026-08-19"^^xsd:date ;
    dcterms:modified "2026-08-25"^^xsd:date ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 24 (Regulation (EU) 2023/1542, Annex VI Part A (9)); Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.1.1 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-extinguisher-classes#" ;
    vann:preferredNamespacePrefix "batext" .

#################################################
# Concept Scheme
#################################################

batext:ExtinguisherClassScheme
    a skos:ConceptScheme ;
    rdfs:label "Extinguisher classes applicable to a battery"@en ;
    skos:prefLabel "Extinguisher classes applicable to a battery"@en ;
    skos:scopeNote "Closed list of five terms, taken verbatim from the Spherity Battery Pass ontology v0.1. The underlying classification standard is an open point: BatteryPass-Ready Data Attribute Long List v1.3, attribute 24, requires the fire class to be determined in accordance with EN 2:2005, which defines classes A, B, C, D and F. Class K is an NFPA 10 (US) class whose EN 2 counterpart is class F, and class C denotes flammable gases in EN 2 but electrical equipment in NFPA 10. Until the reference standard is confirmed, the definitions below state both readings where the two schemes diverge, and the scheme should not be treated as stable."@en ;
    skos:hasTopConcept batext:ClassA ,
                       batext:ClassB ,
                       batext:ClassC ,
                       batext:ClassD ,
                       batext:ClassK ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent; BatteryPass-Ready Data Attribute Long List v1.3, attribute 24"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

#################################################
# Extinguisher classes — skos:Concept individuals
#################################################
# skos:notation is the letter to be used on the battery label.

batext:ClassA
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "A" ;
    rdfs:label "Extinguisher class A"@en ;
    skos:prefLabel "Extinguisher class A"@en ;
    skos:definition "Fires involving combustible solids. Same scope in EN 2:2005 and in NFPA 10."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassB
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "B" ;
    rdfs:label "Extinguisher class B"@en ;
    skos:prefLabel "Extinguisher class B"@en ;
    skos:definition "Fires involving flammable liquids or liquefiable solids. Same scope in EN 2:2005 and in NFPA 10."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassC
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "C" ;
    rdfs:label "Extinguisher class C"@en ;
    skos:prefLabel "Extinguisher class C"@en ;
    skos:definition "Scheme-dependent: fires involving flammable gases under EN 2:2005, fires involving energised electrical equipment under NFPA 10. To be fixed once the reference standard is confirmed."@en ;
    skos:editorialNote "The two readings are not interchangeable. Producers applying EN 2:2005 and producers applying NFPA 10 would populate this value with different meanings."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassD
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "D" ;
    rdfs:label "Extinguisher class D"@en ;
    skos:prefLabel "Extinguisher class D"@en ;
    skos:definition "Fires involving combustible metals. Same scope in EN 2:2005 and in NFPA 10; the class most likely to be relevant to lithium battery cells."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .

batext:ClassK
    a skos:Concept ;
    skos:inScheme batext:ExtinguisherClassScheme ;
    skos:topConceptOf batext:ExtinguisherClassScheme ;
    skos:notation "K" ;
    rdfs:label "Extinguisher class K"@en ;
    skos:prefLabel "Extinguisher class K"@en ;
    skos:definition "Fires involving cooking media (vegetable or animal oils and fats). An NFPA 10 (US) class; EN 2:2005 covers the same scope under class F."@en ;
    skos:editorialNote "Retained because the term appears in the Spherity Battery Pass ontology v0.1 and in issue #8. If the vocabulary is realigned on EN 2:2005 as attribute 24 of the BatteryPass-Ready long list requires, this concept is to be deprecated in favour of a class F concept, using owl:deprecated and dcterms:isReplacedBy."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-extinguisher-classes> .
