@prefix batlab: <https://w3id.org/eudpp/battery-labeling#> .
@prefix bat: <https://w3id.org/eudpp/battery#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################
# Ontology
#################################################
# v0.2: full coverage of the battery-labeling scope of the Gap Analysis
# 1 class, 1 object property, 5 datatype properties.
# NOTE: a cross-sectoral Labelling class is under discussion at CORE
# level (Gap Analysis); if adopted, BatteryLabel will be re-attached
# as a specialisation of it.

<https://w3id.org/eudpp/battery-labeling>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/eudpp/battery-labeling/0.1.0> ;
    rdfs:label "EU DPP Battery Labeling Ontology"@en ;
    dcterms:title "EU DPP Battery Labeling Ontology"@en ;
    dcterms:description "Module for the labels and symbols required on batteries in EU Digital Product Passports: separate collection symbol, symbols for cadmium and lead, extinguishing agent information, label symbol and label subject. Covers the battery-specific fields of the 'Symbols, labels and documentation of conformity' category of the BatteryPass-Ready Data Attribute Long List required by Regulation (EU) 2023/1542, and the Spherity Battery Pass Labeling entities."@en ;
    rdfs:comment "Developed against the CIRPASS-2 CORE ontology v2.0 (update of 30 April 2026). External references are pinned to these versions."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:bibliographicCitation "EU DPP Battery Labeling Ontology. Draft version 0.1.0."@en ;
    dcterms:creator "Nader Jelassi"@en ;
    dcterms:contributor "Arnab Sinha"@en ;
    dcterms:created "2026-07-07"^^xsd:date ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcterms:modified "2026-08-06"^^xsd:date ;
    dcterms:references "Regulation (EU) 2023/1542; BatteryPass-Ready Data Attribute Long List v1.3, attributes 21, 22, 24; Spherity Battery Pass ontology v0.1 (Labeling)"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    owl:versionInfo "Version 0.1.0 DRAFT"@en ;
    vann:preferredNamespaceUri "https://w3id.org/eudpp/battery-labeling#" ;
    vann:preferredNamespacePrefix "batlab" .

#################################################
# Classes
#################################################

batlab:BatteryLabel
    a owl:Class ;
    rdfs:label "Battery Label"@en ;
    rdfs:comment "A label or symbol required on the battery or in its passport under Regulation (EU) 2023/1542 (e.g. separate collection symbol, cadmium and lead symbols, carbon footprint label). Battery-specific class; pending the CORE-level decision on a cross-sectoral Labelling class."@en ;
    dcterms:references "Regulation (EU) 2023/1542"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

#################################################
# Object Properties
#################################################

batlab:hasBatteryLabel
    a owl:ObjectProperty ;
    rdfs:domain bat:Battery ;
    rdfs:range batlab:BatteryLabel ;
    rdfs:label "has battery label"@en ;
    rdfs:comment "Links a battery to a label or symbol required by the Batteries Regulation."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, labels"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

#################################################
# Datatype Properties
#################################################

batlab:separateCollectionSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "separate collection symbol"@en ;
    rdfs:comment "Symbol indicating the necessity of separate collection of the battery (crossed-out wheeled bin), as a link to the symbol resource."@en ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 21"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:cadmiumLeadSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "symbols for cadmium and lead"@en ;
    rdfs:comment "Representation of the chemical symbol 'Cd' for cadmium and 'Pb' for lead contained in the battery, as a link to the symbol resource."@en ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 22"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:extinguishingAgent
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:string ;
    rdfs:label "extinguishing agent"@en ;
    rdfs:comment "Specification of the usable extinguishing agent: applicable fire extinguisher classes (A, B, C, D, K). Value set to be managed as a controlled vocabulary / SHACL constraint."@en ;
    dcterms:references "BatteryPass-Ready Data Attribute Long List v1.3, attribute 24; Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:labelingSymbol
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:anyURI ;
    rdfs:label "labeling symbol"@en ;
    rdfs:comment "Link to the image of the label symbol displayed on the battery."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, labelingSymbol"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .

batlab:labelingSubject
    a owl:DatatypeProperty ;
    rdfs:domain batlab:BatteryLabel ;
    rdfs:range xsd:string ;
    rdfs:label "labeling subject"@en ;
    rdfs:comment "Subject category of the label (SeparateCollection, HazardousMaterial, CarbonFootPrint, ExtinguishingAgent). Value set to be managed as a controlled vocabulary / SHACL constraint."@en ;
    dcterms:references "Spherity Battery Pass ontology v0.1, labelingSubject"@en ;
    rdfs:isDefinedBy <https://w3id.org/eudpp/battery-labeling> .
