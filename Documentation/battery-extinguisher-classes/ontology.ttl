<https://w3id.org/eudpp/battery-extinguisher-classes> rdf:type owl:Ontology ;
                                                       owl:versionIRI <https://w3id.org/eudpp/battery-extinguisher-classes/0.1.1> ;
                                                       <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Battery Extinguisher Classes Vocabulary. Draft version 0.1.1."@en ;
                                                       <http://purl.org/dc/terms/contributor> "Arnab Sinha"@en ;
                                                       <http://purl.org/dc/terms/created> "2026-08-19"^^xsd:date ;
                                                       <http://purl.org/dc/terms/creator> "Marc-Andree Wolf"@en ,
                                                                                          "Nader Jelassi"@en ;
                                                       <http://purl.org/dc/terms/description> "Controlled vocabulary of the extinguisher classes applicable to a battery, used as the value set of batlab:extinguishingAgent. Replaces the free-text values of the battery-labeling module. The five classes A, B, C, D and F are those of EN 2:2005, the standard to which BatteryPass-Ready long list attribute 24 pins the determination of the fire class."@en ;
                                                       <http://purl.org/dc/terms/issued> "2026-08-19"^^xsd:date ;
                                                       <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ,
                                                                                          "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."@en ;
                                                       <http://purl.org/dc/terms/modified> "2026-09-01"^^xsd:date ;
                                                       <http://purl.org/dc/terms/references> "EN 2:2005, Classification of fires; BatteryPass-Ready Data Attribute Long List v1.3, attribute 24 (Regulation (EU) 2023/1542, Annex VI Part A (9)); Spherity Battery Pass ontology v0.1, extinguishingAgent"@en ;
                                                       <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
                                                       <http://purl.org/dc/terms/title> "EU DPP Battery Extinguisher Classes Vocabulary"@en ;
                                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "batext" ;
                                                       <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/battery-extinguisher-classes#" ;
                                                       rdfs:comment "Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). External references are pinned to these versions."@en ;
                                                       rdfs:label "EU DPP Battery Extinguisher Classes Vocabulary"@en ;
                                                       rdfs:seeAlso <https://w3id.org/eudpp/battery-labeling> ;
                                                       owl:versionInfo "Version 0.1.1 DRAFT"@en .

