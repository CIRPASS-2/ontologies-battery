<rdf:RDF xmlns="https://w3id.org/eudpp/battery-categories#"
     xml:base="https://w3id.org/eudpp/battery-categories"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:eudpp="https://w3id.org/eudpp#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/battery-categories">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/battery-categories/0.1.1"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Battery Categories Vocabulary. Draft version 0.1.1.</terms:bibliographicCitation>
        <terms:contributor xml:lang="en">Arnab Sinha</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-18</terms:created>
        <terms:creator xml:lang="en">Marc-Andree Wolf</terms:creator>
        <terms:creator xml:lang="en">Nader Jelassi</terms:creator>
        <terms:description xml:lang="en">Controlled vocabulary of the five battery categories defined in Article 3(1) of Regulation (EU) 2023/1542: portable (9), LMT (11), SLI (12), industrial (13) and electric vehicle (14). Declared as individuals of the cross-sectoral class dpp:ClassificationCode and attached to a battery through dpp:hasProductGroup; no term is declared in the battery namespace. The category conditions the scope of the battery passport.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-18</terms:issued>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license xml:lang="en">This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-01</terms:modified>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 3(1)(9), (11), (12), (13), (14); Regulation (EU) No 168/2013; Regulation (EU) 2018/858</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <terms:title xml:lang="en">EU DPP Battery Categories Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>batcat</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/battery-categories#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). External references are pinned to these versions.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Battery Categories Vocabulary</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery"/>
        <owl:versionInfo xml:lang="en">Version 0.1.1 DRAFT</owl:versionInfo>
    </owl:Ontology>
    


