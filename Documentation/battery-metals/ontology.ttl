<https://w3id.org/eudpp/battery-metals> rdf:type owl:Ontology ;
                                         owl:versionIRI <https://w3id.org/eudpp/battery-metals/0.1.0> ;
                                         <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Battery Metals Vocabulary. Draft version 0.1.0."@en ;
                                         <http://purl.org/dc/terms/contributor> "Arnab Sinha"@en ;
                                         <http://purl.org/dc/terms/created> "2026-09-03"^^xsd:date ;
                                         <http://purl.org/dc/terms/creator> "Marc-Andree Wolf"@en ,
                                                                            "Nader Jelassi"@en ;
                                         <http://purl.org/dc/terms/description> "The four metals whose recycled content Regulation (EU) 2023/1542, Art. 8(1) requires a battery to declare: cobalt, lead, lithium and nickel. Declared as individuals of the cross-sectoral class dpp:MaterialType and used as the value set of eudpp:hasMaterialType on a eudpp:MaterialOfComposition, so that a recycled-content figure can be attributed to a named metal. Corresponds to BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 to 54."@en ;
                                         <http://purl.org/dc/terms/issued> "2026-09-03"^^xsd:date ;
                                         <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ,
                                                                            "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."@en ;
                                         <http://purl.org/dc/terms/modified> "2026-09-03"^^xsd:date ;
                                         <http://purl.org/dc/terms/references> "Regulation (EU) 2023/1542, Art. 8(1) and Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 to 54"@en ;
                                         <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
                                         <http://purl.org/dc/terms/title> "EU DPP Battery Metals Vocabulary"@en ;
                                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "batmet" ;
                                         <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/battery-metals#" ;
                                         rdfs:comment "Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). To be revisited when MAT v2 lands (ontologies-core#24, #25): #25 introduces eudpp:materialTypeScheme, to be added to these four concepts as it is to the ten chemistries, and recycledContentType, which splits pre- from post-consumer shares."@en ;
                                         rdfs:label "EU DPP Battery Metals Vocabulary"@en ;
                                         rdfs:seeAlso <https://w3id.org/eudpp/battery-chemistries> ,
                                                      <https://w3id.org/eudpp/battery-materials> ;
                                         owl:versionInfo "Version 0.1.0 DRAFT"@en .

