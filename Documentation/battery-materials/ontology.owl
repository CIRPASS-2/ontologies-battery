    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#hasMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterial"/>
    


    <!-- https://w3id.org/eudpp/battery-materials#hasBatteryChemistry -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-materials#hasBatteryChemistry">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasMaterial"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryChemistry"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 39; Spherity Battery Pass ontology v0.1, batteryChemistry</terms:references>
        <rdfs:comment xml:lang="en">Links a battery to its electrochemical chemistry. Declared as a sub-property of the CORE product-to-material link dpp:hasMaterial (CONNECTOR).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <rdfs:label xml:lang="en">has battery chemistry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-materials#hasBatteryLocation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-materials#hasBatteryLocation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryChemistry"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryLocation"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, batteryMaterialLocation</terms:references>
        <rdfs:comment xml:lang="en">Links a battery material of composition to its internal location within the battery. The domain is restricted to BatteryChemistry rather than the cross-sectoral MaterialOfComposition, so that this battery-specific property is not asserted on materials of other sectors.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <rdfs:label xml:lang="en">has battery location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp#MaterialOfComposition -->


    <owl:Class rdf:about="https://w3id.org/eudpp#MaterialOfComposition"/>
    


    <!-- https://w3id.org/eudpp/battery#Battery -->


    <owl:Class rdf:about="https://w3id.org/eudpp/battery#Battery"/>
    


    <!-- https://w3id.org/eudpp/battery-materials#BatteryChemistry -->


    <owl:Class rdf:about="https://w3id.org/eudpp/battery-materials#BatteryChemistry">
        <rdfs:subClassOf rdf:resource="https://w3id.org/eudpp#MaterialOfComposition"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 39; Spherity Battery Pass ontology v0.1, BatteryChemistryEntity</terms:references>
        <rdfs:comment xml:lang="en">The electrochemical composition of the battery, reflecting the active materials used in cathode and anode and, voluntarily, electrolyte. Specialises the cross-sectoral MaterialOfComposition class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <rdfs:label xml:lang="en">Battery Chemistry</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/eudpp/battery-materials#BatteryLocation -->


    <owl:Class rdf:about="https://w3id.org/eudpp/battery-materials#BatteryLocation">
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, BatteryLocationEntity</terms:references>
        <rdfs:comment xml:lang="en">An internal location within the battery where a material or sub-component resides. Battery-specific class with no CORE anchor. Its value set is the battery-locations vocabulary, which declares the three locations named by Regulation (EU) 2023/1542, Annex XIII 2(a): cathode, anode and electrolyte.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <rdfs:label xml:lang="en">Battery Location</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery-locations"/>
    </owl:Class>
</rdf:RDF>



