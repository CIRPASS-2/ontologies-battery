<rdf:RDF xmlns="https://w3id.org/eudpp/battery-labeling#"
     xml:base="https://w3id.org/eudpp/battery-labeling"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/battery-labeling">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/battery-labeling/0.2.1"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Battery Labeling Ontology. Draft version 0.2.1.</terms:bibliographicCitation>
        <terms:contributor xml:lang="en">Arnab Sinha</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-07</terms:created>
        <terms:creator xml:lang="en">Marc-Andree Wolf</terms:creator>
        <terms:creator xml:lang="en">Nader Jelassi</terms:creator>
        <terms:description xml:lang="en">Module for the labels and symbols required on batteries in EU Digital Product Passports: separate collection symbol, the cadmium symbol and the lead symbol, extinguishing agent information and label symbol. Covers the battery-specific fields of the &apos;Symbols, labels and documentation of conformity&apos; category of the BatteryPass-Ready Data Attribute Long List required by Regulation (EU) 2023/1542, and the Spherity Battery Pass Labeling entities.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-07</terms:issued>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license xml:lang="en">This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-01</terms:modified>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542; BatteryPass-Ready Data Attribute Long List v1.3, attributes 21, 22, 24; Spherity Battery Pass ontology v0.1 (Labeling)</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <terms:title xml:lang="en">EU DPP Battery Labeling Ontology</terms:title>
        <vann:preferredNamespacePrefix>batlab</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/battery-labeling#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). External references are pinned to these versions.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Battery Labeling Ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <owl:versionInfo xml:lang="en">Version 0.2.1 DRAFT</owl:versionInfo>
    </owl:Ontology>
    


