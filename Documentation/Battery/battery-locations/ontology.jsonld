}, {
  "@id" : "https://w3id.org/eudpp/battery-locations",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EU DPP Battery Locations Vocabulary. Draft version 0.1.0."
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@language" : "en",
    "@value" : "Arnab Sinha"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-25"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Marc-Andree Wolf"
  }, {
    "@language" : "en",
    "@value" : "Nader Jelassi"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The three internal battery locations named by Regulation (EU) 2023/1542, Annex XIII 2(a) for the detailed composition of a battery: cathode, anode and electrolyte. Declared as individuals of batmat:BatteryLocation and used as the value set of batmat:hasBatteryLocation. Corresponds to BatteryPass-Ready Data Attribute Long List v1.3, attribute 41, and to the Spherity Battery Pass class BatteryLocationEntity, which declares no values."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-25"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://www.apache.org/licenses/LICENSE-2.0"
  }, {
    "@language" : "en",
    "@value" : "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-01"
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41; Spherity Battery Pass ontology v0.1, BatteryLocationEntity"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://eur-lex.europa.eu/eli/reg/2023/1542/oj"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "EU DPP Battery Locations Vocabulary"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "batloc"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/eudpp/battery-locations#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). To be revisited when MAT v2 lands (ontologies-core#24, #25), which introduces a part level that may host these locations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP Battery Locations Vocabulary"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://w3id.org/eudpp/battery-materials"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/eudpp/battery-locations/0.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "Version 0.1.0 DRAFT"
  } ]
