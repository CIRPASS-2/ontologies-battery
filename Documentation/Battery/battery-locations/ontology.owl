    <owl:Ontology rdf:about="https://w3id.org/eudpp/battery-locations">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/battery-locations/0.1.0"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Battery Locations Vocabulary. Draft version 0.1.0.</terms:bibliographicCitation>
        <terms:contributor xml:lang="en">Arnab Sinha</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-25</terms:created>
        <terms:creator xml:lang="en">Marc-Andree Wolf</terms:creator>
        <terms:creator xml:lang="en">Nader Jelassi</terms:creator>
        <terms:description xml:lang="en">The three internal battery locations named by Regulation (EU) 2023/1542, Annex XIII 2(a) for the detailed composition of a battery: cathode, anode and electrolyte. Declared as individuals of batmat:BatteryLocation and used as the value set of batmat:hasBatteryLocation. Corresponds to BatteryPass-Ready Data Attribute Long List v1.3, attribute 41, and to the Spherity Battery Pass class BatteryLocationEntity, which declares no values.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-25</terms:issued>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license xml:lang="en">This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-01</terms:modified>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41; Spherity Battery Pass ontology v0.1, BatteryLocationEntity</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <terms:title xml:lang="en">EU DPP Battery Locations Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>batloc</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/battery-locations#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). To be revisited when MAT v2 lands (ontologies-core#24, #25), which introduces a part level that may host these locations.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Battery Locations Vocabulary</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <owl:versionInfo xml:lang="en">Version 0.1.0 DRAFT</owl:versionInfo>
    </owl:Ontology>
    


