    <!-- https://w3id.org/eudpp/battery-locations#Anode -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-locations#Anode">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryLocation"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-locations"/>
        <rdfs:label xml:lang="en">Anode</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
        <skos:notation>anode</skos:notation>
        <skos:prefLabel xml:lang="en">Anode</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-locations#BatteryLocationScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-locations"/>
        <rdfs:label xml:lang="en">Battery locations per Annex XIII 2(a)</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-locations#Anode"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-locations#Cathode"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-locations#Electrolyte"/>
        <skos:prefLabel xml:lang="en">Battery locations per Annex XIII 2(a)</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The three locations named by Regulation (EU) 2023/1542, Annex XIII 2(a). The Regulation names them without defining them, so no definition is asserted here. Access to the detailed composition is restricted to notified bodies, market surveillance authorities and the Commission; per the tier-free convention of this ontology, that restriction is expressed in the SHACL layer, not here.</skos:scopeNote>
    </owl:NamedIndividual>
    


