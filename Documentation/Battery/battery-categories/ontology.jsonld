}, {
  "@id" : "https://w3id.org/eudpp/battery-categories",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EU DPP Battery Categories Vocabulary. Draft version 0.1.1."
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@language" : "en",
    "@value" : "Arnab Sinha"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-18"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "Marc-Andree Wolf"
  }, {
    "@language" : "en",
    "@value" : "Nader Jelassi"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Controlled vocabulary of the five battery categories defined in Article 3(1) of Regulation (EU) 2023/1542: portable (9), LMT (11), SLI (12), industrial (13) and electric vehicle (14). Declared as individuals of the cross-sectoral class dpp:ClassificationCode and attached to a battery through dpp:hasProductGroup; no term is declared in the battery namespace. The category conditions the scope of the battery passport."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-18"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://www.apache.org/licenses/LICENSE-2.0"
  }, {
    "@language" : "en",
    "@value" : "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-01"
  } ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)(9), (11), (12), (13), (14); Regulation (EU) No 168/2013; Regulation (EU) 2018/858"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://eur-lex.europa.eu/eli/reg/2023/1542/oj"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "EU DPP Battery Categories Vocabulary"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "batcat"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/eudpp/battery-categories#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). External references are pinned to these versions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EU DPP Battery Categories Vocabulary"
  } ],
