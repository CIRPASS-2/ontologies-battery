    "@language" : "en",
    "@value" : "Version 0.1.1 DRAFT"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://eur-lex.europa.eu/eli/reg/2023/1542/oj"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Battery categories per Regulation (EU) 2023/1542, Art. 3(1)"
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#ElectricVehicleBattery"
  }, {
    "@id" : "https://w3id.org/eudpp/battery-categories#IndustrialBattery"
  }, {
    "@id" : "https://w3id.org/eudpp/battery-categories#LMTBattery"
  }, {
    "@id" : "https://w3id.org/eudpp/battery-categories#PortableBattery"
  }, {
    "@id" : "https://w3id.org/eudpp/battery-categories#SLIBattery"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Battery categories per Regulation (EU) 2023/1542, Art. 3(1)"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Battery passport scope (Art. 77): LMT, industrial above 2 kWh and electric vehicle batteries are in scope; portable and SLI batteries are not."
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/battery-categories#ElectricVehicleBattery",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)(14)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/eudpp#ClassificationCode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Electric vehicle battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "EV battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a battery that is specifically designed to provide electric power for traction in hybrid or electric vehicles of category L as provided for in Regulation (EU) No 168/2013, that weighs more than 25 kg, or a battery that is specifically designed to provide electric power for traction in hybrid or electric vehicles of categories M, N or O as provided for in Regulation (EU) 2018/858"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "EV"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Electric vehicle battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "In scope of the battery passport."
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeSet" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeValue" : [ {
    "@value" : "EV"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/battery-categories#IndustrialBattery",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)(13)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/eudpp#ClassificationCode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Industrial battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a battery that is specifically designed for industrial uses, intended for industrial uses after having been subject to preparation for repurposing or repurposing, or any other battery that weighs more than 5 kg and that is neither an electric vehicle battery, an LMT battery, nor an SLI battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "industrial"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Industrial battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "In scope of the battery passport above 2 kWh."
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeSet" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeValue" : [ {
    "@value" : "industrial"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/battery-categories#LMTBattery",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)(11)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/eudpp#ClassificationCode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Light means of transport battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "LMT battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a battery that is sealed, weighs 25 kg or less and is specifically designed to provide electric power for the traction of wheeled vehicles that can be powered by an electric motor alone or by a combination of motor and human power, including type-approved vehicles of category L within the meaning of Regulation (EU) No 168/2013 of the European Parliament and of the Council, and that is not an electric vehicle battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "LMT"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Light means of transport battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "In scope of the battery passport."
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeSet" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeValue" : [ {
    "@value" : "LMT"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/battery-categories#PortableBattery",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)(9)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/eudpp#ClassificationCode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Portable battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a battery that is sealed, weighs 5 kg or less, is not designed specifically for industrial use and is neither an electric vehicle battery, an LMT battery, nor an SLI battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "portable"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Portable battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Out of scope of the battery passport."
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeSet" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "https://w3id.org/eudpp#codeValue" : [ {
    "@value" : "portable"
  } ]
}, {
  "@id" : "https://w3id.org/eudpp/battery-categories#SLIBattery",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "Regulation (EU) 2023/1542, Art. 3(1)(12)"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/eudpp#ClassificationCode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Starting, lighting and ignition battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "SLI battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a battery that is specifically designed to supply electric power for starting, lighting, or ignition and that can also be used for auxiliary or backup purposes in vehicles, other means of transport or machinery"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SLI"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Starting, lighting and ignition battery"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Out of scope of the battery passport."
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/eudpp/battery-categories#BatteryCategoryScheme"
  } ],
