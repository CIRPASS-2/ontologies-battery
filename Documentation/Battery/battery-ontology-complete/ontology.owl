    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassA -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassA">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class A</rdfs:label>
        <skos:definition xml:lang="en">Fires involving combustible solids. Same scope in EN 2:2005 and in NFPA 10.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>A</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class A</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassB -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassB">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class B</rdfs:label>
        <skos:definition xml:lang="en">Fires involving flammable liquids or liquefiable solids. Same scope in EN 2:2005 and in NFPA 10.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>B</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class B</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassC">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class C</rdfs:label>
        <skos:definition xml:lang="en">Fires involving flammable gases, per EN 2:2005.</skos:definition>
        <skos:editorialNote xml:lang="en">Mapping trap. Under NFPA 10 the same letter denotes fires involving energised electrical equipment. The two readings are not interchangeable, so a value of C taken from a US-sourced data set must not be carried across unchecked.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>C</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class C</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassD -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassD">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class D</rdfs:label>
        <skos:definition xml:lang="en">Fires involving combustible metals. Same scope in EN 2:2005 and in NFPA 10; the class most likely to be relevant to lithium battery cells.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>D</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class D</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassF -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassF">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">EN 2:2005, Classification of fires; Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class F</rdfs:label>
        <skos:altLabel xml:lang="en">K (NFPA 10)</skos:altLabel>
        <skos:definition xml:lang="en">Fires involving cooking media (vegetable or animal oils and fats), per EN 2:2005.</skos:definition>
        <skos:editorialNote xml:lang="en">Renamed from batext:ClassK on 26 August 2026, when EN 2:2005 was settled as the reference standard in issue #8. Renamed outright rather than deprecated: the namespace has never been published under w3id.org.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>F</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class F</skos:prefLabel>
        <skos:scopeNote xml:lang="en">EN 2:2005 class F and NFPA 10 (US) class K have the same scope. The US letter is kept as skos:altLabel so that data sourced from NFPA 10, such as the Spherity Battery Pass ontology v0.1, still maps onto this concept.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:references xml:lang="en">EN 2:2005, Classification of fires; BatteryPass-Ready Data Attribute Long List v1.3, attribute 24; Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher classes applicable to a battery</rdfs:label>
        <skos:editorialNote xml:lang="en">Re-check flag. ISO 3941:2026 introduces a class L for lithium-ion battery fires, which EN 2 does not have. The class is directly pertinent to batteries, so this vocabulary is to be re-checked if EN 2 is amended, or if the final labelling Implementing Act references a standard other than EN 2:2005.</skos:editorialNote>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassA"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassB"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassC"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassD"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassF"/>
        <skos:prefLabel xml:lang="en">Extinguisher classes applicable to a battery</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Closed list of the five classes of EN 2:2005 — A, B, C, D and F — the standard to which BatteryPass-Ready long list attribute 24 pins the determination of the fire class. Two mapping traps for data sourced from NFPA 10 (US), which the Spherity Battery Pass ontology v0.1 follows: NFPA class K is EN 2 class F, kept here as a skos:altLabel on batext:ClassF; and NFPA class C denotes energised electrical equipment where EN 2 class C denotes flammable gases, so the letter C cannot be carried across unchanged.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-locations#Anode -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-locations#Anode">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryLocation"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-locations"/>
        <rdfs:label xml:lang="en">Anode</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
        <skos:notation>anode</skos:notation>
        <skos:prefLabel xml:lang="en">Anode</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-locations#BatteryLocationScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-locations"/>
        <rdfs:label xml:lang="en">Battery locations per Annex XIII 2(a)</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-locations#Anode"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-locations#Cathode"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-locations#Electrolyte"/>
        <skos:prefLabel xml:lang="en">Battery locations per Annex XIII 2(a)</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The three locations named by Regulation (EU) 2023/1542, Annex XIII 2(a). The Regulation names them without defining them, so no definition is asserted here. Access to the detailed composition is restricted to notified bodies, market surveillance authorities and the Commission; per the tier-free convention of this ontology, that restriction is expressed in the SHACL layer, not here.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-locations#Cathode -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-locations#Cathode">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryLocation"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-locations"/>
        <rdfs:label xml:lang="en">Cathode</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
        <skos:notation>cathode</skos:notation>
        <skos:prefLabel xml:lang="en">Cathode</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-locations#Electrolyte -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-locations#Electrolyte">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryLocation"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(a); BatteryPass-Ready Data Attribute Long List v1.3, attribute 41</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-locations"/>
        <rdfs:label xml:lang="en">Electrolyte</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
        <skos:notation>electrolyte</skos:notation>
        <skos:prefLabel xml:lang="en">Electrolyte</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-locations#BatteryLocationScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-metals#BatteryMetalScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 8(1)</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-metals"/>
        <rdfs:label xml:lang="en">Battery metals subject to recycled content declaration, Art. 8(1)</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-metals#Cobalt"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-metals#Lead"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-metals#Lithium"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-metals#Nickel"/>
        <skos:prefLabel xml:lang="en">Battery metals subject to recycled content declaration, Art. 8(1)</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Art. 8(1) does not treat the four metals alike. For cobalt, lithium and nickel it asks for the share present in ACTIVE MATERIALS and recovered from battery manufacturing waste or post-consumer waste; for lead it asks for the share present in THE BATTERY and recovered from waste. The distinction is recorded on each concept and is not expressible in the CORE today.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-metals#Cobalt -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-metals#Cobalt">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 49 and 52</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-metals"/>
        <rdfs:label xml:lang="en">Cobalt</rdfs:label>
        <skos:altLabel xml:lang="en">Co</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
        <skos:notation>Co</skos:notation>
        <skos:prefLabel xml:lang="en">Cobalt</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Recycled share is measured on the cobalt present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 49 and 52.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-metals#Lead -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-metals#Lead">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attribute 54</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-metals"/>
        <rdfs:label xml:lang="en">Lead</rdfs:label>
        <skos:altLabel xml:lang="en">Pb</skos:altLabel>
        <skos:editorialNote xml:lang="en">Not to be confused with batchem:Pb, the lead-acid CELL CHEMISTRY of battery-chemistries. This concept is the METAL whose recycled content is declared. Different namespaces, different meanings.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
        <skos:notation>Pb</skos:notation>
        <skos:prefLabel xml:lang="en">Lead</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Lead is the exception in Art. 8(1): the recycled share is measured on the lead present in THE BATTERY, not in active materials, and recovered from waste without the manufacturing / post-consumer split. Long list attribute 54, which has no pre- and post-consumer counterpart.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-metals#Lithium -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-metals#Lithium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 50 and 53</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-metals"/>
        <rdfs:label xml:lang="en">Lithium</rdfs:label>
        <skos:altLabel xml:lang="en">Li</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
        <skos:notation>Li</skos:notation>
        <skos:prefLabel xml:lang="en">Lithium</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Recycled share is measured on the lithium present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 50 and 53.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-metals#Nickel -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-metals#Nickel">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/eudpp#MaterialType"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 8(1); BatteryPass-Ready Data Attribute Long List v1.3, attributes 48 and 51</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-metals"/>
        <rdfs:label xml:lang="en">Nickel</rdfs:label>
        <skos:altLabel xml:lang="en">Ni</skos:altLabel>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
        <skos:notation>Ni</skos:notation>
        <skos:prefLabel xml:lang="en">Nickel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Recycled share is measured on the nickel present in active materials, recovered from battery manufacturing waste or post-consumer waste. Long list attributes 48 and 51.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-metals#BatteryMetalScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-statuses"/>
        <rdfs:label xml:lang="en">Battery lifecycle statuses per Annex XIII 4(c)</rdfs:label>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-statuses#Original"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-statuses#ReUsed"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-statuses#Remanufactured"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-statuses#Repurposed"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-statuses#Waste"/>
        <skos:prefLabel xml:lang="en">Battery lifecycle statuses per Annex XIII 4(c)</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Closed list of five terms. The status is dynamic at individual-battery granularity: it is updated on placing on the market and on every status change. A new battery passport is issued when the battery has been remanufactured, repurposed or subjected to a treatment operation preparing for re-use or repurposing and is placed on the market again; the link back to the previous passport is carried by the CORE property dpp:linkToPreviousDPP, not by this vocabulary. Access to the battery status is restricted to persons with a legitimate interest — a conformance rule expressed in the SHACL shapes, not in this ontology.</skos:scopeNote>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-statuses#Original -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-statuses#Original">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c)</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-statuses"/>
        <rdfs:label xml:lang="en">Original</rdfs:label>
        <skos:definition xml:lang="en">The battery is in its first life, as placed on the market by the manufacturer, and has not been subjected to re-use, repurposing or remanufacturing.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
        <skos:notation>original</skos:notation>
        <skos:prefLabel xml:lang="en">Original</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-statuses#ReUsed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-statuses#ReUsed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c)</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-statuses"/>
        <rdfs:label xml:lang="en">Re-used</rdfs:label>
        <skos:altLabel xml:lang="en">reused</skos:altLabel>
        <skos:definition xml:lang="en">The battery has been subjected to a treatment operation preparing it for re-use and placed on the market again for the purpose it was originally designed for.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
        <skos:notation>re-used</skos:notation>
        <skos:prefLabel xml:lang="en">Re-used</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A repaired battery is recorded under this status, with the repair itself made transparent through the repair history. The history belongs to the CORE event module (dpp:RepairEvent); no &apos;repaired&apos; status is declared here.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-statuses#Remanufactured -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-statuses#Remanufactured">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c)</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-statuses"/>
        <rdfs:label xml:lang="en">Remanufactured</rdfs:label>
        <skos:definition xml:lang="en">The battery has been subjected to remanufacturing and placed on the market again.</skos:definition>
        <skos:editorialNote xml:lang="en">Remanufacturing is an ESPR-wide notion, not a battery-specific one. This is the concept most likely to move to the CORE if a generic product status is introduced.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
        <skos:notation>remanufactured</skos:notation>
        <skos:prefLabel xml:lang="en">Remanufactured</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-statuses#Repurposed -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-statuses#Repurposed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c)</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-statuses"/>
        <rdfs:label xml:lang="en">Repurposed</rdfs:label>
        <skos:definition xml:lang="en">The battery has been subjected to repurposing and placed on the market again for a purpose or application other than the one it was originally designed for.</skos:definition>
        <skos:editorialNote xml:lang="en">The definition of &apos;repurposing&apos; is in Art. 3(1) of Regulation (EU) 2023/1542; the point number is to be confirmed against the consolidated text.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
        <skos:notation>repurposed</skos:notation>
        <skos:prefLabel xml:lang="en">Repurposed</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-statuses#Waste -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-statuses#Waste">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c)</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-statuses"/>
        <rdfs:label xml:lang="en">Waste</rdfs:label>
        <skos:definition xml:lang="en">The battery is a waste battery: it is discarded or intended to be discarded, and is no longer placed on the market as a battery.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
        <skos:notation>waste</skos:notation>
        <skos:prefLabel xml:lang="en">Waste</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Reaching this status does not by itself deactivate the passport. Passport deactivation is a property of the digital resource, carried by dpp:dppStatus on dpp:DPP.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
    </owl:NamedIndividual>
</rdf:RDF>



