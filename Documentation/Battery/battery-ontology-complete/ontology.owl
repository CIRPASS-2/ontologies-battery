    <!-- https://w3id.org/eudpp#hasMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasMaterial"/>
    


    <!-- https://w3id.org/eudpp#hasProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp#hasProperty"/>
    


    <!-- https://w3id.org/eudpp/battery#hasBatteryStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery#hasBatteryStatus">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Links a battery to its lifecycle status: one of the five individuals of the battery-statuses vocabulary (original, repurposed, re-used, remanufactured, waste). This is the status of the battery as a physical item, and not the status of its passport as a digital resource, which the CORE carries on dpp:DPP through dpp:dppStatus. Declared locally, unlike the battery category and the battery chemistry, because the CORE has no generic product status property to reuse: dpp:hasProductGroup carries the product group, not the state of the item. This is a stopgap: a cross-sectoral eudpp:productStatus on eudpp:Product was requested in CIRPASS-2/ontologies-core#35 (opened 22 June 2026, still open), motivated by this very attribute. When it lands, this property is to be deprecated in favour of it, using owl:deprecated and dcterms:isReplacedBy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">has battery status</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://github.com/CIRPASS-2/ontologies-core/issues/35"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery-statuses#BatteryStatusScheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-labeling#extinguishingAgent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-labeling#extinguishingAgent">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-labeling#BatteryLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 24 (Regulation (EU) 2023/1542, Annex VI Part A (9)); Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:comment xml:lang="en">Specification of the usable extinguishing agent, as one of the extinguisher classes of the battery-extinguisher-classes vocabulary. Retyped from a free-text datatype property in v0.2.0: the value set is now controlled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-labeling"/>
        <rdfs:label xml:lang="en">extinguishing agent</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-labeling#hasBatteryLabel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-labeling#hasBatteryLabel">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-labeling#BatteryLabel"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, labels</terms:references>
        <rdfs:comment xml:lang="en">Links a battery to a label or symbol required by the Batteries Regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-labeling"/>
        <rdfs:label xml:lang="en">has battery label</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-materials#hasBatteryChemistry -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-materials#hasBatteryChemistry">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasMaterial"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryChemistry"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 39; Spherity Battery Pass ontology v0.1, batteryChemistry</terms:references>
        <rdfs:comment xml:lang="en">Links a battery to its electrochemical chemistry. Declared as a sub-property of the CORE product-to-material link dpp:hasMaterial (CONNECTOR).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <rdfs:label xml:lang="en">has battery chemistry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-materials#hasBatteryLocation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-materials#hasBatteryLocation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryChemistry"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-materials#BatteryLocation"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, batteryMaterialLocation</terms:references>
        <rdfs:comment xml:lang="en">Links a battery material of composition to its internal location within the battery. The domain is restricted to BatteryChemistry rather than the cross-sectoral MaterialOfComposition, so that this battery-specific property is not asserted on materials of other sectors.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-materials"/>
        <rdfs:label xml:lang="en">has battery location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#hasBatteryDurability -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-performance#hasBatteryDurability">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryDurability"/>
        <rdfs:comment xml:lang="en">Links a battery to its durability data. Specialises the cross-sectoral dpp:hasProperty (Product -&gt; Property); the chain BatteryDurability = dpp:Durability = QualityIndicator = QuantitativeProperty = Property was verified in P_DPP v2.0.0.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">has battery durability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#hasBatteryPerformance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-performance#hasBatteryPerformance">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:comment xml:lang="en">Links a battery to its electrochemical performance and in-use state data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">has battery performance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#hasBatteryStateRecord -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-performance#hasBatteryStateRecord">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:comment xml:lang="en">Links a battery to one dated record of its in-use state. A battery carries as many records as there are readings; no ordering property is declared, the as-of date orders the series.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">has battery state record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#hasTemperatureExposure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/eudpp/battery-performance#hasTemperatureExposure">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/eudpp#hasProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="https://w3id.org/eudpp/battery-performance#TemperatureExposure"/>
        <rdfs:comment xml:lang="en">Links a battery to its in-use thermal exposure data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">has temperature exposure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/eudpp/battery#dismantlingInformation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#dismantlingInformation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(c)</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Link to the dismantling documentation: exploded diagrams, disassembly sequences, fastening techniques, required tools, safety warnings, and the number and layout of cells. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">dismantling information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery#dueDiligenceAudit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#dueDiligenceAudit">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 52 and Annex X; Annex XIII Part C</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Link to the third-party verification of the battery due diligence policy, carried out by a notified body. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">due diligence audit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery#dueDiligenceReport -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#dueDiligenceReport">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Art. 52 and Annex X; Annex XIII Part C</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Link to the battery due diligence policy and report on the supply chain, covering the raw materials listed in Annex X (cobalt, natural graphite, lithium, nickel) and the chemical compounds based on them. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">due diligence report</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery#partNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#partNumber">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(b); BatteryPass-Ready Data Attribute Long List v1.3, attribute 45; Spherity Battery Pass ontology v0.1, partNumber</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Manufacturer part number of a component of the battery, and of the battery itself where one is assigned. Annex XIII 2(b) asks for the part numbers of the components, so the subject is the component and not the battery: CIRPASS-2 decided in June 2026 not to introduce a Component class, a component being a product in its own right, linked to the battery through the CORE property dpp:isComponentOf. The domain is therefore dpp:Product rather than bat:Battery. The property is declared in the battery namespace because the CORE has no cross-sectoral part number; adding one was raised as a recommendation to the Commission. Typed as in the Spherity Battery Pass ontology v0.1, where bp:partNumber is an xsd:string datatype property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">part number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery#safetyMeasures -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#safetyMeasures">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 2(d)</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Link to the safety measures applicable to the battery. The document the URL points at is a digital instruction in the sense of the cross-sectoral class eudpp:DigitalInstruction (P_DPP), and the correspondence is recorded here as rdfs:seeAlso. It is deliberately not a SKOS mapping: this is a datatype property carrying a URL, eudpp:DigitalInstruction is a class of documents, and an alignment between the two would not hold at audit. Re-expressing this property on a CORE document pattern is the subject of ontologies-battery#11 and is deferred until that pattern is settled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">safety measures</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp#DigitalInstruction"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery#testReportResults -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#testReportResults">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 3</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Link to the test report results. Access is restricted to notified bodies, market surveillance authorities and the Commission; the restriction is expressed in the SHACL layer, not here. Migration to the CORE document pattern eudpp:Source (LCA module) is tracked in ontologies-battery#11 and deferred until the LCA module is integrated into the CORE; xsd:anyURI is the agreed interim.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">test report results</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery#warrantyPeriod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery#warrantyPeriod">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery#Battery"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 1(m); BatteryPass-Ready Data Attribute Long List v1.3, attribute 17; Spherity Battery Pass ontology v0.1, warrentyPeriod</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">Length of the commercial warranty covering the calendar life of the battery, as an ISO 8601 duration - for example &quot;P24M&quot; for twenty-four months. Declared in the battery namespace on the decision of 26 August 2026: a cross-sectoral warranty period was requested in CIRPASS-2/ontologies-core#34, but the ESPR does not require one, whereas Regulation (EU) 2023/1542 does, so the term stays sectoral.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery"/>
        <rdfs:label xml:lang="en">warranty period</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://github.com/CIRPASS-2/ontologies-core/issues/34"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-labeling#cadmiumSymbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-labeling#cadmiumSymbol">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-labeling#BatteryLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 22 (Regulation (EU) 2023/1542, Annex XIII (1s), Art. 13(5))</terms:references>
        <rdfs:comment xml:lang="en">Representation of the chemical symbol &apos;Cd&apos; for cadmium, as a link to the symbol resource. Its legal trigger is its own: the symbol is required for batteries containing more than 0,002 % cadmium by weight, independently of the lead symbol.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-labeling"/>
        <rdfs:label xml:lang="en">symbol for cadmium</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-labeling#labelingSymbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-labeling#labelingSymbol">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-labeling#BatteryLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, labelingSymbol</terms:references>
        <rdfs:comment xml:lang="en">Link to the image of the label symbol displayed on the battery.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-labeling"/>
        <rdfs:label xml:lang="en">labeling symbol</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-labeling#leadSymbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-labeling#leadSymbol">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-labeling#BatteryLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 22 (Regulation (EU) 2023/1542, Annex XIII (1s), Art. 13(5))</terms:references>
        <rdfs:comment xml:lang="en">Representation of the chemical symbol &apos;Pb&apos; for lead, as a link to the symbol resource. Its legal trigger is its own: the symbol is required for batteries containing more than 0,004 % lead by weight, independently of the cadmium symbol.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-labeling"/>
        <rdfs:label xml:lang="en">symbol for lead</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-labeling#separateCollectionSymbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-labeling#separateCollectionSymbol">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-labeling#BatteryLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 21 (Regulation (EU) 2023/1542, Annex XIII (1s), Art. 13(4), Annex VI Part B)</terms:references>
        <rdfs:comment xml:lang="en">Symbol indicating the necessity of separate collection of the battery (crossed-out wheeled bin), as a link to the symbol resource. Required on all batteries; the symbol itself is set out in Annex VI Part B.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-labeling"/>
        <rdfs:label xml:lang="en">separate collection symbol</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#accidentInformation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#accidentInformation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#AccidentEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 100</terms:references>
        <rdfs:comment xml:lang="en">Information on accidents affecting the battery, including when incorporated in equipment it is powering, as a link to the relevant resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">information on accidents</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#asOfDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#asOfDate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <rdfs:comment xml:lang="en">The date and time the values of this record were read. xsd:dateTimeStamp rather than xsd:dateTime: the time zone offset is then mandatory, so no separate offset property is needed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">as-of date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#cRateOfCycleLifeTest -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#cRateOfCycleLifeTest">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 87</terms:references>
        <rdfs:comment xml:lang="en">Measurement parameter for &apos;Expected lifetime: Number of charge-discharge cycles&apos;: applied charge and discharge rate in terms of rated capacity (C-rate) of the relevant cycle-life reference test. Unit: ampere per ampere-hour (A/Ah).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">C-rate of relevant cycle-life test</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#capacityFade -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#capacityFade">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 61</terms:references>
        <rdfs:comment xml:lang="en">The decrease over time and upon usage in the amount of charge that a battery can deliver at the rated voltage, with respect to the original rated capacity as declared by the manufacturer. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">capacity fade</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#capacityThresholdForExhaustion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#capacityThresholdForExhaustion">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryDurability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 90</terms:references>
        <rdfs:comment xml:lang="en">The percentage of SOCE (State of Certified Energy), above which the battery is still considered operational as EV battery in its current life, as provided by the economic operator. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">capacity threshold for exhaustion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#capacityThroughput -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#capacityThroughput">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 89</terms:references>
        <rdfs:comment xml:lang="en">The overall sum of the capacity throughput over the battery lifetime at a specific time during usage. Unit: ampere-hour (Ah).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">capacity throughput</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#certifiedUsableBatteryEnergy -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#certifiedUsableBatteryEnergy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 62</terms:references>
        <rdfs:comment xml:lang="en">The usable battery energy according to the procedure in the UN GTR No 22 as determined during the certification of the vehicle. Unit: kilowatt-hour (kWh).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">certified usable battery energy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#currentSelfDischargeRate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#currentSelfDischargeRate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 79</terms:references>
        <rdfs:comment xml:lang="en">The change of the self-discharge rate in an idle state of the battery in reference conditions (temperature etc.) at aging parameter x, e.g. after a certain amount of storage time or number of cycles. Unit: percent per month (%/month).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">current self-discharge rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#cycleLifeReferenceTest -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#cycleLifeReferenceTest">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 86</terms:references>
        <rdfs:comment xml:lang="en">The reference test for &apos;Expected lifetime: Number of charge-discharge cycles&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">cycle-life reference test</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#energyThroughput -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#energyThroughput">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 88</terms:references>
        <rdfs:comment xml:lang="en">The overall sum of the energy throughput over the battery lifetime at a specific time during usage. Unit: kilowatt-hour (kWh).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">energy throughput</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#expectedLifetimeCalendarYears -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#expectedLifetimeCalendarYears">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryDurability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 83</terms:references>
        <rdfs:comment xml:lang="en">Expected lifetime under the reference conditions for which the battery has been designed, in calendar years. Unit: year.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">expected lifetime in calendar years</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#expectedLifetimeCycles -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#expectedLifetimeCycles">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryDurability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 84</terms:references>
        <rdfs:comment xml:lang="en">Expected lifetime under the reference conditions for which the battery has been designed, in number of charge-discharge cycles (except for non-cycle applications).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">expected lifetime: number of charge-discharge cycles</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#initialInternalResistance -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#initialInternalResistance">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 81</terms:references>
        <rdfs:comment xml:lang="en">&apos;Quotient of change of voltage of a battery by the corresponding change in discharge current under specified conditions&apos; (IEV 482 03 36), at begin of life, for battery cell and pack (module recommended). Unit: ohm.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">initial internal resistance of battery cell and pack</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/ohm"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#initialRoundTripEnergyEfficiency -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#initialRoundTripEnergyEfficiency">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 74</terms:references>
        <rdfs:comment xml:lang="en">The ratio of the net energy delivered by a battery during a discharge test to the total energy required to restore the initial state of charge by a standard charge (see Regulation (EU) 2023/1542, Annex IV (6)). Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">initial round trip energy efficiency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#initialSelfDischargeRate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#initialSelfDischargeRate">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 78</terms:references>
        <rdfs:comment xml:lang="en">The self-discharge rate in an idle state of the battery in reference conditions (temperature etc.) at begin of life. Unit: percent per month (%/month).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">initial self-discharge rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#internalResistanceIncrease -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#internalResistanceIncrease">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 82</terms:references>
        <rdfs:comment xml:lang="en">The increase over time and upon usage of internal resistance, for the pack (cell and module recommended). Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">internal resistance increase of pack</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#maximumPermittedBatteryPower -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#maximumPermittedBatteryPower">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 72</terms:references>
        <rdfs:comment xml:lang="en">The value of maximum permitted power the battery is rated for and reflects the data relevant for power limits. Unit: watt (W). Declared as Integer [W] in the BatteryPass-Ready long list; xsd:decimal retained per the Gap Analysis decision (open question to BatteryPass-Ready).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">maximum permitted battery power</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/watt"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#maximumVoltage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#maximumVoltage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 67</terms:references>
        <rdfs:comment xml:lang="en">The upper voltage limit that the safe operation of the battery is rated for. Unit: volt (V).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">maximum voltage</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/volt"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#minimumVoltage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#minimumVoltage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 66</terms:references>
        <rdfs:comment xml:lang="en">The lower voltage limit that the safe operation of the battery is rated for. Unit: volt (V).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">minimum voltage</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/volt"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#nominalVoltage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#nominalVoltage">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 68</terms:references>
        <rdfs:comment xml:lang="en">The suitable approximate value of the voltage used to designate or identify the battery. Unit: volt (V).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">nominal voltage</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/volt"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#numberOfDeepDischargeEvents -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#numberOfDeepDischargeEvents">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 98</terms:references>
        <rdfs:comment xml:lang="en">The number of occasions, in which voltage has dropped below the lower operational limit as provided in the battery passport. In-use event counter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">number of deep discharge events</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#numberOfFullCycles -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#numberOfFullCycles">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 85</terms:references>
        <rdfs:comment xml:lang="en">In-use number of (full) charging and discharging cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">number of full charging and discharging cycles</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#numberOfOverchargeEvents -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#numberOfOverchargeEvents">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 99</terms:references>
        <rdfs:comment xml:lang="en">The number of occasions, in which voltage has increased above the upper operational limit as provided in the battery passport. In-use event counter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">number of overcharge events</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#originalPowerCapability -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#originalPowerCapability">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 69</terms:references>
        <rdfs:comment xml:lang="en">The amount of energy that a battery is capable to provide over a given period of time under reference conditions. Unit: watt (W).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">original power capability</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/watt"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#powerFade -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#powerFade">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 71</terms:references>
        <rdfs:comment xml:lang="en">The decrease over time and upon usage in the amount of power that a battery can deliver at the rated voltage. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">power fade</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#powerToEnergyRatio -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#powerToEnergyRatio">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 73</terms:references>
        <rdfs:comment xml:lang="en">The suitable approximate value of the power capability used to designate or identify the battery, while the battery energy is determined in reference conditions to be defined. Unit: watt per watt-hour (W/Wh). Declared as Integer [W/Wh] in the BatteryPass-Ready long list; xsd:decimal retained per the Gap Analysis decision (open question to BatteryPass-Ready).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">ratio between nominal battery power and battery energy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#ratedCapacity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#ratedCapacity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 59</terms:references>
        <rdfs:comment xml:lang="en">The total number of ampere-hours that can be withdrawn from a fully charged battery under reference conditions. Unit: ampere-hour (Ah), or milliampere-hour (mAh) for LMT batteries.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">rated capacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#remainingCapacity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#remainingCapacity">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 60</terms:references>
        <rdfs:comment xml:lang="en">The corresponding in-use data attribute to rated capacity. Unit: ampere-hour (Ah).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">remaining capacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#remainingPowerCapability -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#remainingPowerCapability">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 70</terms:references>
        <rdfs:comment xml:lang="en">The amount of energy that a battery is capable to provide over a given period of time under reference conditions at a distinct point in time during its usage. Unit: watt (W).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">remaining power capability</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/watt"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#remainingRoundTripEnergyEfficiency -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#remainingRoundTripEnergyEfficiency">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 76</terms:references>
        <rdfs:comment xml:lang="en">The in-use analogy to the initial round trip energy efficiency: the ratio of the net energy delivered by a battery during a discharge test to the total energy required to restore the initial state of charge by a standard charge. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">remaining round trip energy efficiency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#remainingUsableBatteryEnergy -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#remainingUsableBatteryEnergy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 63</terms:references>
        <rdfs:comment xml:lang="en">The usable battery energy at the present point in the lifetime of a battery as determined according to the procedure in the UN GTR No 22. Unit: kilowatt-hour (kWh).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">remaining usable battery energy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#roundTripEnergyEfficiencyAt50PercentCycleLife -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#roundTripEnergyEfficiencyAt50PercentCycleLife">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 75</terms:references>
        <rdfs:comment xml:lang="en">The ratio of the net energy delivered by a battery during a discharge test to the total energy required to restore the initial state of charge by a standard charge, measured at 50% of cycle life (see Regulation (EU) 2023/1542, Annex IV (6)). Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">round trip energy efficiency at 50% of cycle life</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#roundTripEnergyEfficiencyFade -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#roundTripEnergyEfficiencyFade">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 77</terms:references>
        <rdfs:comment xml:lang="en">The decrease of round trip energy efficiency as percentage. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">energy round trip efficiency fade</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#selfDischargeRateEvolution -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#selfDischargeRateEvolution">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 80</terms:references>
        <rdfs:comment xml:lang="en">The change of self-discharge over time and usage, as percentage calculated from the initial and current self-discharge rate. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">evolution of self-discharge rates</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#stateOfCertifiedEnergy -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#stateOfCertifiedEnergy">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 64</terms:references>
        <rdfs:comment xml:lang="en">The measured or on-board usable battery energy performance at a specific point in its lifetime, expressed as a percentage of the certified usable battery energy. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">state of certified energy (SOCE)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#stateOfCharge -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#stateOfCharge">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 65</terms:references>
        <rdfs:comment xml:lang="en">The available energy or charge in a battery expressed as a percentage of rated capacity as declared by the manufacturer. When the battery&apos;s state of health is no longer equal to its initial condition, SoC refers to the maximum energy or charge that can be stored in the battery at the time of charging. Unit: percent (%).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">state of charge (SoC)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#temperatureInformation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#temperatureInformation">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 91</terms:references>
        <rdfs:comment xml:lang="en">Temperature information regarding operating environmental conditions. Unit: degree Celsius (°C).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">temperature information</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/degreeCelsius"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#temperatureRangeIdleStateLowerBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#temperatureRangeIdleStateLowerBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#TemperatureExposure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 92</terms:references>
        <rdfs:comment xml:lang="en">The lower boundary of the surrounding temperature range. Unit: degree Celsius (°C).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">temperature range idle state, lower boundary</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/degreeCelsius"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#temperatureRangeIdleStateUpperBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#temperatureRangeIdleStateUpperBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#TemperatureExposure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 93</terms:references>
        <rdfs:comment xml:lang="en">The upper boundary of the surrounding temperature range. Unit: degree Celsius (°C).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">temperature range idle state, upper boundary</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/degreeCelsius"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#timeSpentChargingInExtremeTemperaturesAboveBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#timeSpentChargingInExtremeTemperaturesAboveBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 96</terms:references>
        <rdfs:comment xml:lang="en">The aggregated time, in which the battery is charged, while temperatures above the upper boundary of the temperature range as defined in &apos;Temperature range idle state, upper boundary&apos; are prevalent. Unit: minute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">time spent charging during extreme temperatures above boundary</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/minute"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#timeSpentChargingInExtremeTemperaturesBelowBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#timeSpentChargingInExtremeTemperaturesBelowBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 97</terms:references>
        <rdfs:comment xml:lang="en">The aggregated time, in which the battery is charged, while temperatures below the lower boundary of the temperature range as defined in &apos;Temperature range idle state, lower boundary&apos; are prevalent. Unit: minute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">time spent charging during extreme temperatures below boundary</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/minute"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#timeSpentInExtremeTemperaturesAboveBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#timeSpentInExtremeTemperaturesAboveBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 94</terms:references>
        <rdfs:comment xml:lang="en">The aggregated time, in which temperatures above the upper boundary of the temperature range as defined in &apos;Temperature range idle state, upper boundary&apos; are prevalent. Unit: minute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">time spent in extreme temperatures above boundary</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/minute"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/eudpp/battery-performance#timeSpentInExtremeTemperaturesBelowBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/eudpp/battery-performance#timeSpentInExtremeTemperaturesBelowBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/eudpp/battery-performance#BatteryStateRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <terms:references xml:lang="en">BatteryPass-Ready Data Attribute Long List v1.3, attribute 95</terms:references>
        <rdfs:comment xml:lang="en">The aggregated time, in which temperatures below the lower boundary of the temperature range as defined in &apos;Temperature range idle state, lower boundary&apos; are prevalent. Unit: minute.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-performance"/>
        <rdfs:label xml:lang="en">time spent in extreme temperatures below boundary</rdfs:label>
        <battery-performance:measurementUnit rdf:resource="https://si-digital-framework.org/SI/units/minute"/>
    </owl:DatatypeProperty>
    


