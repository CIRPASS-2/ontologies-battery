     -->


    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassA -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassA">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class A</rdfs:label>
        <skos:definition xml:lang="en">Fires involving combustible solids. Same scope in EN 2:2005 and in NFPA 10.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>A</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class A</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassB -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassB">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class B</rdfs:label>
        <skos:definition xml:lang="en">Fires involving flammable liquids or liquefiable solids. Same scope in EN 2:2005 and in NFPA 10.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>B</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class B</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassC">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class C</rdfs:label>
        <skos:definition xml:lang="en">Fires involving flammable gases, per EN 2:2005.</skos:definition>
        <skos:editorialNote xml:lang="en">Mapping trap. Under NFPA 10 the same letter denotes fires involving energised electrical equipment. The two readings are not interchangeable, so a value of C taken from a US-sourced data set must not be carried across unchecked.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>C</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class C</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassD -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassD">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class D</rdfs:label>
        <skos:definition xml:lang="en">Fires involving combustible metals. Same scope in EN 2:2005 and in NFPA 10; the class most likely to be relevant to lithium battery cells.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>D</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class D</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ClassF -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ClassF">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:references xml:lang="en">EN 2:2005, Classification of fires; Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher class F</rdfs:label>
        <skos:altLabel xml:lang="en">K (NFPA 10)</skos:altLabel>
        <skos:definition xml:lang="en">Fires involving cooking media (vegetable or animal oils and fats), per EN 2:2005.</skos:definition>
        <skos:editorialNote xml:lang="en">Renamed from batext:ClassK on 26 August 2026, when EN 2:2005 was settled as the reference standard in issue #8. Renamed outright rather than deprecated: the namespace has never been published under w3id.org.</skos:editorialNote>
        <skos:inScheme rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
        <skos:notation>F</skos:notation>
        <skos:prefLabel xml:lang="en">Extinguisher class F</skos:prefLabel>
        <skos:scopeNote xml:lang="en">EN 2:2005 class F and NFPA 10 (US) class K have the same scope. The US letter is kept as skos:altLabel so that data sourced from NFPA 10, such as the Spherity Battery Pass ontology v0.1, still maps onto this concept.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme -->


    <owl:NamedIndividual rdf:about="https://w3id.org/eudpp/battery-extinguisher-classes#ExtinguisherClassScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:references xml:lang="en">EN 2:2005, Classification of fires; BatteryPass-Ready Data Attribute Long List v1.3, attribute 24; Spherity Battery Pass ontology v0.1, extinguishingAgent</terms:references>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes"/>
        <rdfs:label xml:lang="en">Extinguisher classes applicable to a battery</rdfs:label>
        <skos:editorialNote xml:lang="en">Re-check flag. ISO 3941:2026 introduces a class L for lithium-ion battery fires, which EN 2 does not have. The class is directly pertinent to batteries, so this vocabulary is to be re-checked if EN 2 is amended, or if the final labelling Implementing Act references a standard other than EN 2:2005.</skos:editorialNote>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassA"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassB"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassC"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassD"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/eudpp/battery-extinguisher-classes#ClassF"/>
        <skos:prefLabel xml:lang="en">Extinguisher classes applicable to a battery</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Closed list of the five classes of EN 2:2005 — A, B, C, D and F — the standard to which BatteryPass-Ready long list attribute 24 pins the determination of the fire class. Two mapping traps for data sourced from NFPA 10 (US), which the Spherity Battery Pass ontology v0.1 follows: NFPA class K is EN 2 class F, kept here as a skos:altLabel on batext:ClassF; and NFPA class C denotes energised electrical equipment where EN 2 class C denotes flammable gases, so the letter C cannot be carried across unchanged.</skos:scopeNote>
    </owl:NamedIndividual>
</rdf:RDF>



