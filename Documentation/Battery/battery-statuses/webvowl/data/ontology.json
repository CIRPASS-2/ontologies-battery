        "scopeNote" : [ {
          "identifier" : "scopeNote",
          "language" : "en",
          "value" : "Closed list of five terms. The status is dynamic at individual-battery granularity: it is updated on placing on the market and on every status change. A new battery passport is issued when the battery has been remanufactured, repurposed or subjected to a treatment operation preparing for re-use or repurposing and is placed on the market again; the link back to the previous passport is carried by the CORE property dpp:linkToPreviousDPP, not by this vocabulary. Access to the battery status is restricted to persons with a legitimate interest — a conformance rule expressed in the SHACL shapes, not in this ontology.",
          "type" : "label"
        } ]
      },
      "labels" : {
        "IRI-based" : "BatteryStatusScheme",
        "en" : "Battery lifecycle statuses per Annex XIII 4(c)"
      }
