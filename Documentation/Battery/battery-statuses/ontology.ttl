<https://w3id.org/eudpp/battery-statuses> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/eudpp/battery-statuses/0.1.1> ;
                                           <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Battery Statuses Vocabulary. Draft version 0.1.1."@en ;
                                           <http://purl.org/dc/terms/contributor> "Arnab Sinha"@en ;
                                           <http://purl.org/dc/terms/created> "2026-08-19"^^xsd:date ;
                                           <http://purl.org/dc/terms/creator> "Marc-Andree Wolf"@en ,
                                                                              "Nader Jelassi"@en ;
                                           <http://purl.org/dc/terms/description> "The five lifecycle statuses of a battery required by Regulation (EU) 2023/1542, Annex XIII 4(c): original, repurposed, re-used, remanufactured and waste. Value set of bat:hasBatteryStatus. Distinct from the status of the digital passport, which is carried by the cross-sectoral dpp:dppStatus."@en ;
                                           <http://purl.org/dc/terms/issued> "2026-08-19"^^xsd:date ;
                                           <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ,
                                                                              "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."@en ;
                                           <http://purl.org/dc/terms/modified> "2026-09-01"^^xsd:date ;
                                           <http://purl.org/dc/terms/references> "Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20"@en ;
                                           <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
                                           <http://purl.org/dc/terms/title> "EU DPP Battery Statuses Vocabulary"@en ;
                                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "batstat" ;
                                           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/battery-statuses#" ;
                                           rdfs:comment "Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). External references are pinned to these versions."@en ;
                                           rdfs:label "EU DPP Battery Statuses Vocabulary"@en ;
                                           rdfs:seeAlso <https://w3id.org/eudpp/battery> ;
                                           owl:versionInfo "Version 0.1.1 DRAFT"@en .

