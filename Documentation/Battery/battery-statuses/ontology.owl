     xml:base="https://w3id.org/eudpp/battery-statuses"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/eudpp/battery-statuses">
        <owl:versionIRI rdf:resource="https://w3id.org/eudpp/battery-statuses/0.1.1"/>
        <terms:bibliographicCitation xml:lang="en">EU DPP Battery Statuses Vocabulary. Draft version 0.1.1.</terms:bibliographicCitation>
        <terms:contributor xml:lang="en">Arnab Sinha</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-19</terms:created>
        <terms:creator xml:lang="en">Marc-Andree Wolf</terms:creator>
        <terms:creator xml:lang="en">Nader Jelassi</terms:creator>
        <terms:description xml:lang="en">The five lifecycle statuses of a battery required by Regulation (EU) 2023/1542, Annex XIII 4(c): original, repurposed, re-used, remanufactured and waste. Value set of bat:hasBatteryStatus. Distinct from the status of the digital passport, which is carried by the cross-sectoral dpp:dppStatus.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-19</terms:issued>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license xml:lang="en">This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0).</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-01</terms:modified>
        <terms:references xml:lang="en">Regulation (EU) 2023/1542, Annex XIII 4(c); BatteryPass-Ready Data Attribute Long List v1.3, attribute 20</terms:references>
        <terms:source rdf:resource="https://eur-lex.europa.eu/eli/reg/2023/1542/oj"/>
        <terms:title xml:lang="en">EU DPP Battery Statuses Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>batstat</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eudpp/battery-statuses#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). External references are pinned to these versions.</rdfs:comment>
        <rdfs:label xml:lang="en">EU DPP Battery Statuses Vocabulary</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/eudpp/battery"/>
        <owl:versionInfo xml:lang="en">Version 0.1.1 DRAFT</owl:versionInfo>
    </owl:Ontology>
    


