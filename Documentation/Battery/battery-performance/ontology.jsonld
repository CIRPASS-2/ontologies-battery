  "@id" : "https://w3id.org/eudpp/battery-performance#numberOfDeepDischargeEvents",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "BatteryPass-Ready Data Attribute Long List v1.3, attribute 98"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
