  "@id" : "https://w3id.org/eudpp/battery-performance#temperatureRangeIdleStateLowerBoundary",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
