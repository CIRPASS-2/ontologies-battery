  "http://purl.org/dc/terms/references" : [ {
    "@language" : "en",
    "@value" : "BatteryPass-Ready Data Attribute Long List v1.3, attribute 71"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The decrease over time and upon usage in the amount of power that a battery can deliver at the rated voltage. Unit: percent (%)."
