<https://w3id.org/eudpp/battery-chemistries> rdf:type owl:Ontology ;
                                              owl:versionIRI <https://w3id.org/eudpp/battery-chemistries/0.1.1> ;
                                              <http://purl.org/dc/terms/bibliographicCitation> "EU DPP Battery Chemistries Vocabulary. Draft version 0.1.1."@en ;
                                              <http://purl.org/dc/terms/contributor> "Arnab Sinha"@en ;
                                              <http://purl.org/dc/terms/created> "2026-08-18"^^xsd:date ;
                                              <http://purl.org/dc/terms/creator> "Marc-Andree Wolf"@en ,
                                                                                 "Nader Jelassi"@en ;
                                              <http://purl.org/dc/terms/description> "The ten battery chemistry terms prescribed by the draft labelling Implementing Act under Regulation (EU) 2023/1542, as listed in BatteryPass-Ready Data Attribute Long List v1.3, attribute 39. Declared as individuals of the cross-sectoral class dpp:MaterialType of the CORE MAT module and reached through the inherited dpp:hasMaterialType. Replaces the free-text chemistry names of the battery-materials module."@en ;
                                              <http://purl.org/dc/terms/issued> "2026-08-18"^^xsd:date ;
                                              <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ,
                                                                                 "This ontology is licensed under the Apache License, Version 2.0. In case of dispute over Apache 2.0 applicability, or in case considering the ontology as a document, this ontology document is to be considered licensed under the Creative Commons Attribution 4.0 International (CC BY 4.0)."@en ;
                                              <http://purl.org/dc/terms/modified> "2026-09-01"^^xsd:date ;
                                              <http://purl.org/dc/terms/references> "BatteryPass-Ready Data Attribute Long List v1.3, attribute 39; draft labelling Implementing Act under Regulation (EU) 2023/1542"@en ;
                                              <http://purl.org/dc/terms/source> <https://eur-lex.europa.eu/eli/reg/2023/1542/oj> ;
                                              <http://purl.org/dc/terms/title> "EU DPP Battery Chemistries Vocabulary"@en ;
                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "batchem" ;
                                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/eudpp/battery-chemistries#" ;
                                              rdfs:comment "Developed against the CIRPASS-2 CORE ontology v2.0.5 (refresh of 25 August 2026; P_DPP v2.0.6 of 27 August 2026, MAT v1.0.2). To be revisited when MAT v2 lands (ontologies-core#24, #25) and when the labelling Implementing Act is adopted."@en ;
                                              rdfs:label "EU DPP Battery Chemistries Vocabulary"@en ;
                                              rdfs:seeAlso <https://w3id.org/eudpp/battery-materials> ;
                                              owl:versionInfo "Version 0.1.1 DRAFT"@en .

